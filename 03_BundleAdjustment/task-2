import os
import subprocess
from pathlib import Path


PROJECT_DIR = Path(r"E:\python learn\zuoye3\03_BundleAdjustment")
IMAGE_DIR = PROJECT_DIR / "data" / "images"

WORK_DIR = PROJECT_DIR / "data" / "work1" / "colmap_out"
DB_PATH = WORK_DIR / "database.db"
SPARSE_DIR = WORK_DIR / "sparse"
DENSE_DIR = WORK_DIR / "dense"

COLMAP_EXE = "colmap"


def run_cmd(cmd):
    print("\n[Running]")
    print(" ".join(str(c) for c in cmd))
    result = subprocess.run(cmd, shell=True)
    if result.returncode != 0:
        raise RuntimeError(f"Command failed: {' '.join(str(c) for c in cmd)}")


def main():
    WORK_DIR.mkdir(parents=True, exist_ok=True)
    SPARSE_DIR.mkdir(parents=True, exist_ok=True)
    DENSE_DIR.mkdir(parents=True, exist_ok=True)

    print(f"Project dir : {PROJECT_DIR}")
    print(f"Image dir   : {IMAGE_DIR}")
    print(f"Work dir    : {WORK_DIR}")

    run_cmd([
        COLMAP_EXE,
        "feature_extractor",
        "--database_path", DB_PATH,
        "--image_path", IMAGE_DIR,
        "--ImageReader.single_camera", "1",
        "--SiftExtraction.use_gpu", "1"
    ])

    run_cmd([
        COLMAP_EXE,
        "exhaustive_matcher",
        "--database_path", DB_PATH,
        "--SiftMatching.use_gpu", "1"
    ])

    run_cmd([
        COLMAP_EXE,
        "mapper",
        "--database_path", DB_PATH,
        "--image_path", IMAGE_DIR,
        "--output_path", SPARSE_DIR
    ])

    sparse_model_dir = SPARSE_DIR / "0"
    if not sparse_model_dir.exists():
        raise FileNotFoundError(f"未找到稀疏重建结果: {sparse_model_dir}")

    run_cmd([
        COLMAP_EXE,
        "image_undistorter",
        "--image_path", IMAGE_DIR,
        "--input_path", sparse_model_dir,
        "--output_path", DENSE_DIR,
        "--output_type", "COLMAP"
    ])

    run_cmd([
        COLMAP_EXE,
        "patch_match_stereo",
        "--workspace_path", DENSE_DIR,
        "--workspace_format", "COLMAP",
        "--PatchMatchStereo.geom_consistency", "true"
    ])

    run_cmd([
        COLMAP_EXE,
        "stereo_fusion",
        "--workspace_path", DENSE_DIR,
        "--workspace_format", "COLMAP",
        "--input_type", "geometric",
        "--output_path", DENSE_DIR / "fused.ply"
    ])

    print("\n重建完成！")
    print(f"稀疏模型: {sparse_model_dir}")
    print(f"稠密点云: {DENSE_DIR / 'fused.ply'}")


if __name__ == "__main__":
    main()
